# Per-viewer data from the company pack. Brief says: treat as personal data, do not upload
# to services that retain it. Evaluators already have these; copy them into pack/ to run.
pack/data/
pack/pilot/
pack/replay/
pack/*.pdf

__pycache__/
*.pyc
*.db
.DS_Store

# Sample run: commit the required reports, not the bulk (regenerate all with
#   PYTHONPATH=src python3 -m agent run --pack pack --out sample_run)
sample_run/sim/
sample_run/viewer_state/*
# a few per-viewer states, chosen to show each kind of decision (see sample_run/final_report.md)
!sample_run/viewer_state/U-04094.json
!sample_run/viewer_state/U-04945.json
!sample_run/viewer_state/U-01386.json
!sample_run/viewer_state/U-02808.json
!sample_run/viewer_state/U-01991.json
!sample_run/viewer_state/U-03051.json
!sample_run/viewer_state/U-01704.json
!sample_run/viewer_state/U-04907.json
